# ==============================================================================
# AI Task Assistant — Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your deployment environment.
# DO NOT commit real secrets, API keys, or production tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Local execution default:
DATABASE_URL=sqlite:///./tasks.db
# Docker Compose persistent volume path (automatically set in compose.yaml):
# DATABASE_URL=sqlite:////app/data/tasks.db

# ------------------------------------------------------------------------------
# 2. Intent Extraction Mode
# ------------------------------------------------------------------------------
# Supported modes: 'deterministic' (recommended for offline, testing, and zero-cost)
#                  'llm' (uses external LLM provider configured below)
INTENT_MODE=deterministic

# ------------------------------------------------------------------------------
# 3. External LLM Provider (Active only if INTENT_MODE=llm)
# ------------------------------------------------------------------------------
# Supported providers: 'openai' (standard) or compatible base URL (e.g., Groq)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 4. Business Timezone & Reference Clock
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Riyadh

# Reference datetime override for reproducible testing (format: YYYY-MM-DD HH:MM:SS)
# Leave empty for live real-time execution:
REFERENCE_DATETIME_OVERRIDE=



# ------------------------------------------------------------------------------
# 6. Streamlit / Web UI Backend Connection
# ------------------------------------------------------------------------------
# Local run: http://127.0.0.1:8000
# Docker Compose internal network (automatically set in compose.yaml): http://api:8000
BACKEND_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 7. Business Policies & Maintenance
# ------------------------------------------------------------------------------
# Weekend days list (0=Mon, 1=Tue, 2=Wed, 3=Thu, 4=Fri, 5=Sat, 6=Sun)
COMPANY_WEEKEND_DAYS=[4]

# Task soft-archival retention window (in days)
TASK_ARCHIVE_RETENTION_DAYS=30

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
